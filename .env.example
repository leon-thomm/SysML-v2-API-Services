# Environment variables for SysML v2 API Services Docker deployment
# Copy this file to .env and update the values as needed

# Database Configuration
# Warning: Change the password for production deployments!
DB_PASSWORD=mysecretpassword

# Optional: Override other database settings
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=sysml2
# DB_USER=postgres

# Hibernate Schema Management
# Options: update (default, preserves data), create, create-drop, validate, none
# HIBERNATE_DDL_AUTO=update
